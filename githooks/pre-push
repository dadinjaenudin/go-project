#!/bin/sh
#
# Hook: memicu pipeline Tekton otomatis setiap kali push ke branch main.
#
# Dipasang oleh tekton/setup-triggers.ps1 lewat:
#   git config core.hooksPath githooks
#
# ---------------------------------------------------------------------------
# KENAPA TIDAK LANGSUNG KIRIM SAAT HOOK JALAN
#
# Git tidak punya hook "post-push". Yang ada hanya "pre-push", dan namanya
# jujur: ia berjalan SEBELUM commit sampai di GitHub.
#
# Kalau webhook dikirim saat itu juga, task git-clone akan menarik kode LAMA --
# commit yang baru saja Anda push belum ada di GitHub. Pipeline hijau, tapi
# yang di-build versi sebelumnya. Persis jenis bug yang paling sulit disadari.
#
# Karena itu hook ini menyalakan proses latar yang MENUNGGU sampai GitHub
# benar-benar punya commit tersebut (dicek dengan git ls-remote), baru
# mengirim webhook. Push Anda sendiri tidak ikut tertahan.
# ---------------------------------------------------------------------------

REMOTE_NAME="$1"
REMOTE_URL="$2"

REPO_ROOT=$(git rev-parse --show-toplevel)
SECRET_FILE="$REPO_ROOT/webhook-secret.txt"
LOG="$REPO_ROOT/.git/tekton-trigger.log"

WEBHOOK_URL="${TEKTON_WEBHOOK_URL:-http://localhost:8095}"
BRANCH_DIPANTAU="${TEKTON_TRIGGER_BRANCH:-main}"
BATAS_TUNGGU_DETIK=90

ZERO="0000000000000000000000000000000000000000"

# Lewati kalau sengaja dimatikan: SKIP_TEKTON=1 git push
if [ -n "$SKIP_TEKTON" ]; then
    echo "[tekton] dilewati (SKIP_TEKTON diset)"
    exit 0
fi

if [ ! -f "$SECRET_FILE" ]; then
    echo "[tekton] webhook-secret.txt tidak ada -- trigger dilewati."
    echo "[tekton] jalankan: powershell -File tekton\\setup-triggers.ps1"
    exit 0
fi

SECRET=$(tr -d '\r\n' < "$SECRET_FILE")

# ---------------------------------------------------------------------------
# Proses latar: tunggu GitHub punya commit-nya, lalu kirim webhook.
# ---------------------------------------------------------------------------
kirim_setelah_sampai() {
    sha="$1"
    branch="$2"
    clone_url="$3"

    mulai=$(date +%s)

    while :; do
        sha_remote=$(git ls-remote "$REMOTE_NAME" "refs/heads/$branch" 2>/dev/null | cut -f1)

        if [ "$sha_remote" = "$sha" ]; then
            break
        fi

        sekarang=$(date +%s)
        if [ $((sekarang - mulai)) -ge $BATAS_TUNGGU_DETIK ]; then
            echo "$(date '+%F %T') GAGAL: setelah ${BATAS_TUNGGU_DETIK}s, $branch di remote masih $sha_remote (menunggu $sha)" >> "$LOG"
            return 1
        fi

        sleep 2
    done

    pesan=$(git log -1 --pretty=%s "$sha" 2>/dev/null | tr -d '"\\' | cut -c1-100)
    pendorong=$(git config user.name 2>/dev/null || echo "unknown")

    body_file=$(mktemp)
    # Bentuk payload mengikuti event push GitHub, karena interceptor github
    # dan TriggerBinding membacanya dengan struktur itu.
    cat > "$body_file" <<JSON
{"ref":"refs/heads/$branch","after":"$sha","before":"","created":false,"deleted":false,"repository":{"clone_url":"$clone_url","full_name":"local/push"},"pusher":{"name":"$pendorong"},"head_commit":{"id":"$sha","message":"$pesan"}}
JSON

    # Tanda tangan dihitung dari FILE yang sama persis dengan yang dikirim.
    # Menandatangani string lalu mengirim ulang hasil echo berisiko beda byte
    # (newline, escaping) sehingga verifikasi gagal dengan 401.
    sig=$(openssl dgst -sha256 -hmac "$SECRET" -r "$body_file" | cut -d' ' -f1)

    http=$(curl -s -o "$body_file.resp" -w '%{http_code}' \
        -X POST "$WEBHOOK_URL" \
        -H 'Content-Type: application/json' \
        -H 'X-GitHub-Event: push' \
        -H "X-GitHub-Delivery: local-$sha" \
        -H "X-Hub-Signature-256: sha256=$sig" \
        --data-binary "@$body_file" \
        --max-time 15)

    {
        echo "$(date '+%F %T') sha=$sha branch=$branch http=$http"
        echo "  respons: $(cat "$body_file.resp" 2>/dev/null)"
    } >> "$LOG"

    rm -f "$body_file" "$body_file.resp"

    [ "$http" = "202" ] || [ "$http" = "201" ] || [ "$http" = "200" ]
}

# ---------------------------------------------------------------------------
# Git mengirim daftar ref yang akan di-push lewat stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# ---------------------------------------------------------------------------
ada_trigger=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue

    # Hanya branch yang dipantau
    [ "$remote_ref" = "refs/heads/$BRANCH_DIPANTAU" ] || continue

    # Penghapusan branch (git push --delete) -- tidak ada yang perlu di-build
    [ "$local_sha" = "$ZERO" ] && continue

    ada_trigger=1

    echo "[tekton] push ke $BRANCH_DIPANTAU terdeteksi ($(echo "$local_sha" | cut -c1-7))"
    echo "[tekton] pipeline akan dipicu setelah commit sampai di GitHub"
    echo "[tekton] pantau: kubectl get pipelinerun -n cicd -l trigger=github-push"
    echo "[tekton] log hook: .git/tekton-trigger.log"

    # Dilepas ke latar supaya push tidak tertahan menunggu GitHub.
    kirim_setelah_sampai "$local_sha" "$BRANCH_DIPANTAU" "$REMOTE_URL" >/dev/null 2>&1 &
done

if [ "$ada_trigger" = "0" ]; then
    echo "[tekton] bukan push ke $BRANCH_DIPANTAU -- pipeline tidak dipicu"
fi

# Selalu izinkan push berlanjut. Masalah pada trigger tidak boleh
# menghalangi pekerjaan Git.
exit 0
